{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name -> live URL will be https://rack-readiness-agent.<your-subdomain>.workers.dev
  "name": "rack-readiness-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI binding: exposes env.AI so we can call Llama 3.3.
  // "remote": true means local dev also calls the real model on Cloudflare.
  "ai": { "binding": "AI", "remote": true },

  // Static UI (built by Vite). Only /agents/* requests hit the Worker code;
  // everything else is served straight from Cloudflare's asset cache.
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },

  // The agent is a Durable Object. "name" is the env binding,
  // "class_name" is the exported class in src/server.ts.
  "durable_objects": {
    "bindings": [{ "class_name": "RackOpsAgent", "name": "RackOpsAgent" }]
  },

  // new_sqlite_classes gives the Durable Object its own SQLite database
  // (where mock data, readiness results, reports and chat history live).
  "migrations": [{ "new_sqlite_classes": ["RackOpsAgent"], "tag": "v1" }]
}
